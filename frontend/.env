# ==============================================================================
# NAIRA HOSPITAL - CHIEF DOCTOR CRM INTEGRATION CONFIGURATION
# ==============================================================================

# Chief Doctor CRM Login API Endpoint
# Default: Uses Vite backend proxy to local API (/api/doctor/login)
# When your friend's CRM is ready, replace with their production API endpoint:
# Example: VITE_CRM_API_URL=https://api.doctor-crm.com/v1/auth/login
VITE_CRM_API_URL=/api/doctor/login

# Chief Doctor CRM Dashboard URL (Optional)
# If your friend's CRM dashboard is on an external domain, set it here:
# Example: VITE_CRM_EXTERNAL_URL=https://crm.nairahospital.org/chief-doctor
# Leave blank to use the built-in protected Chief Doctor workspace (/doctor-crm)
VITE_CRM_EXTERNAL_URL=
